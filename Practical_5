<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Spice Haven - Food Menu</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

  <!-- Header -->
  <header class="bg-red-600 text-white py-6 shadow-md">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold">
        🍽️ Spice Haven
      </h1>
      <p class="mt-2 text-lg">
        Delicious food, unforgettable taste
      </p>
    </div>
  </header>


  <!-- Food Menu Section -->
  <section class="py-12 px-6">

    <div class="max-w-7xl mx-auto">

      <!-- Section Heading -->
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800">
          Our Popular Dishes
        </h2>

        <p class="text-gray-600 mt-3">
          Explore the delicious dishes loved by our customers.
        </p>
      </div>


      <!-- Food Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">


        <!-- Card 1 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=800&q=80"
            alt="Margherita Pizza"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Margherita Pizza
            </h3>

            <p class="text-gray-600 mb-5">
              Classic Italian pizza topped with fresh tomatoes,
              mozzarella cheese and basil.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹299
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>


        <!-- Card 2 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80"
            alt="Cheese Burger"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Cheese Burger
            </h3>

            <p class="text-gray-600 mb-5">
              Juicy grilled burger with melted cheese, lettuce,
              tomato and our special sauce.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹249
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>


        <!-- Card 3 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1551892374-ecf8754cf8b0?auto=format&fit=crop&w=800&q=80"
            alt="Creamy Pasta"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Creamy Pasta
            </h3>

            <p class="text-gray-600 mb-5">
              Soft pasta tossed in creamy Alfredo sauce with
              herbs and parmesan cheese.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹279
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>


        <!-- Card 4 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1546793665-c74683f339c1?auto=format&fit=crop&w=800&q=80"
            alt="Fresh Salad"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Fresh Garden Salad
            </h3>

            <p class="text-gray-600 mb-5">
              Fresh vegetables, crisp lettuce and healthy greens
              served with a light dressing.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹199
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>


        <!-- Card 5 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80"
            alt="Grilled Steak"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Grilled Steak
            </h3>

            <p class="text-gray-600 mb-5">
              Tender grilled steak seasoned with aromatic herbs
              and served with fresh vegetables.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹599
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>


        <!-- Card 6 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg
                    hover:shadow-2xl hover:-translate-y-2
                    transition duration-300">

          <img
            src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=800&q=80"
            alt="Chocolate Cake"
            class="w-full h-56 object-cover"
          >

          <div class="p-6">

            <h3 class="text-2xl font-bold text-gray-800 mb-2">
              Chocolate Cake
            </h3>

            <p class="text-gray-600 mb-5">
              Rich and delicious chocolate cake topped with
              creamy chocolate frosting.
            </p>

            <div class="flex items-center justify-between">

              <span class="text-xl font-bold text-red-600">
                ₹179
              </span>

              <button
                class="bg-red-600 hover:bg-red-700 text-white
                       font-semibold px-5 py-2 rounded-lg
                       transition">
                Order Now
              </button>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-6 text-center">

    <h2 class="text-2xl font-bold">
      Spice Haven
    </h2>

    <p class="text-gray-400 mt-2">
      © 2026 Spice Haven. All Rights Reserved.
    </p>

  </footer>

</body>
</html>
