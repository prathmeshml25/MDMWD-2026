<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TechKart - Product Store</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 text-gray-800">

    <!-- Header -->
    <header class="bg-emerald-700 text-white">
        <div class="max-w-7xl mx-auto px-5 py-5
                    flex flex-col md:flex-row
                    items-center justify-between gap-4">

            <h1 class="text-3xl font-bold">
                TechKart
            </h1>

            <nav class="flex gap-6 text-sm font-medium">
                <a href="#" class="hover:text-yellow-300">
                    Home
                </a>

                <a href="#products" class="hover:text-yellow-300">
                    Products
                </a>

                <a href="#contact" class="hover:text-yellow-300">
                    Contact
                </a>
            </nav>
        </div>
    </header>


    <!-- Hero Section -->
    <section class="bg-white text-center px-5 py-14">

        <span class="text-emerald-600 font-semibold">
            NEW ARRIVALS
        </span>

        <h2 class="text-4xl md:text-5xl font-bold mt-3 mb-4">
            Upgrade Your Technology
        </h2>

        <p class="text-gray-500 max-w-2xl mx-auto">
            Discover stylish and affordable gadgets designed
            to make your everyday life smarter and easier.
        </p>

        <a href="#products"
           class="inline-block mt-6 bg-emerald-600
                  text-white px-6 py-3 rounded-full
                  hover:bg-emerald-800 transition">
            Explore Products
        </a>

    </section>


    <!-- Products -->
    <main id="products"
          class="max-w-7xl mx-auto px-5 py-12">

        <div class="text-center mb-10">

            <h2 class="text-3xl font-bold">
                Featured Products
            </h2>

            <p class="text-gray-500 mt-2">
                Choose your favorite gadget
            </p>

        </div>


        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2
                    lg:grid-cols-3 gap-8">


            <!-- Product 1 -->
            <div class="bg-white rounded-2xl overflow-hidden
                        shadow-lg hover:-translate-y-2
                        transition duration-300">

                <div class="relative">

                    <img
                        src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853"
                        class="w-full h-60 object-cover"
                        alt="Laptop">

                    <span class="absolute top-4 left-4
                                 bg-yellow-400 text-gray-900
                                 px-3 py-1 rounded-full
                                 text-xs font-bold">
                        BEST SELLER
                    </span>

                </div>

                <div class="p-6">

                    <h3 class="text-2xl font-bold mb-2">
                        Premium Laptop
                    </h3>

                    <p class="text-gray-500 mb-5">
                        Powerful performance with a slim and
                        modern design for everyday work.
                    </p>

                    <div class="flex items-center
                                justify-between">

                        <span class="text-2xl font-bold
                                     text-emerald-600">
                            ₹49,999
                        </span>

                        <button
                            class="bg-emerald-600 text-white
                                   px-5 py-2 rounded-lg
                                   hover:bg-emerald-800">
                            Buy Now
                        </button>

                    </div>

                </div>
            </div>


            <!-- Product 2 -->
            <div class="bg-white rounded-2xl overflow-hidden
                        shadow-lg hover:-translate-y-2
                        transition duration-300">

                <div class="relative">

                    <img
                        src="https://images.unsplash.com/photo-1587829741301-dc798b83add3"
                        class="w-full h-60 object-cover"
                        alt="Keyboard">

                    <span class="absolute top-4 left-4
                                 bg-emerald-600 text-white
                                 px-3 py-1 rounded-full
                                 text-xs font-bold">
                        NEW
                    </span>

                </div>

                <div class="p-6">

                    <h3 class="text-2xl font-bold mb-2">
                        Gaming Keyboard
                    </h3>

                    <p class="text-gray-500 mb-5">
                        Comfortable mechanical keyboard
                        designed for gaming and productivity.
                    </p>

                    <div class="flex items-center
                                justify-between">

                        <span class="text-2xl font-bold
                                     text-emerald-600">
                            ₹2,499
                        </span>

                        <button
                            class="bg-emerald-600 text-white
                                   px-5 py-2 rounded-lg
                                   hover:bg-emerald-800">
                            Buy Now
                        </button>

                    </div>

                </div>
            </div>


            <!-- Product 3 -->
            <div class="bg-white rounded-2xl overflow-hidden
                        shadow-lg hover:-translate-y-2
                        transition duration-300">

                <div class="relative">

                    <img
                        src="https://images.unsplash.com/photo-1527864550417-7fd91fc51a46"
                        class="w-full h-60 object-cover"
                        alt="Computer Mouse">

                    <span class="absolute top-4 left-4
                                 bg-blue-500 text-white
                                 px-3 py-1 rounded-full
                                 text-xs font-bold">
                        POPULAR
                    </span>

                </div>

                <div class="p-6">

                    <h3 class="text-2xl font-bold mb-2">
                        Wireless Mouse
                    </h3>

                    <p class="text-gray-500 mb-5">
                        Lightweight wireless mouse with
                        smooth control and comfortable grip.
                    </p>

                    <div class="flex items-center
                                justify-between">

                        <span class="text-2xl font-bold
                                     text-emerald-600">
                            ₹899
                        </span>

                        <button
                            class="bg-emerald-600 text-white
                                   px-5 py-2 rounded-lg
                                   hover:bg-emerald-800">
                            Buy Now
                        </button>

                    </div>

                </div>
            </div>


           
    </main>


    <!-- Contact Section -->
    <section id="contact"
             class="bg-emerald-50 text-center px-5 py-12">

        <h2 class="text-3xl font-bold mb-3">
            Need Help?
        </h2>

        <p class="text-gray-600 mb-5">
            Contact our support team for product information.
        </p>

        <button
            class="bg-emerald-700 text-white
                   px-6 py-3 rounded-lg
                   hover:bg-emerald-900">
            Contact Us
        </button>

    </section>


    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center py-6">

        <h3 class="font-bold text-lg">
            TechKart
        </h3>

        <p class="text-gray-400 text-sm mt-2">
            © 2026 TechKart. All Rights Reserved.
        </p>

    </footer>

</body>
</html>
